<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="working-tree" value="../../artifacts/readme-snippets/feed" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="working-tree">
      <package pattern="TokenGuard.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
